# Owner/admin token — open the app as:
#   http://localhost:5177/?admin=your-secret-token
# Guests use the plain URL without ?admin=
ADMIN_TOKEN=change-me-owner-token

# Optional on Vercel: connect a Blob store so saved palettes persist for all guests.
# Locally, palettes are written to apps/web/data/palettes.json instead.
# BLOB_READ_WRITE_TOKEN=
